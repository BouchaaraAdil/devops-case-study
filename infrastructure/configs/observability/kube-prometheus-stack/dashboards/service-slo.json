              "placement": "bottom"
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          }
        },
        {
          "id": 21,
          "type": "timeseries",
          "title": "p95 latency by version",
          "description": "Latency per image, to spot a slow release.",
