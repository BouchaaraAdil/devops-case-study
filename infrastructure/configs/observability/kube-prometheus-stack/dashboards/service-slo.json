        {
          "id": 20,
          "type": "timeseries",
          "title": "Errors by version",
          "description": "5xx share per image. A new version with more errors = roll back.",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "gridPos": {
            "x": 8,
            "y": 40,
            "w": 8,
            "h": 8
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "expr": "(sum by (image) (rate({__name__=~\".+_requests_total\", job=\"$service\", endpoint!~\"/health|/ready|/metrics\", status=~\"5..\"}[$__rate_interval]) * on (namespace, pod) group_left (image) max by (namespace, pod, image) (kube_pod_container_info{namespace=\"$service\"})) or sum by (image) (rate({__name__=~\".+_requests_total\", job=\"$service\", endpoint!~\"/health|/ready|/metrics\"}[$__rate_interval]) * on (namespace, pod) group_left (image) max by (namespace, pod, image) (kube_pod_container_info{namespace=\"$service\"})) * 0) / sum by (image) (rate({__name__=~\".+_requests_total\", job=\"$service\", endpoint!~\"/health|/ready|/metrics\"}[$__rate_interval]) * on (namespace, pod) group_left (image) max by (namespace, pod, image) (kube_pod_container_info{namespace=\"$service\"}))",
              "legendFormat": "{{image}}",
              "refId": "A"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percentunit",
              "min": 0,
              "custom": {
                "fillOpacity": 10,
                "showPoints": "never",
