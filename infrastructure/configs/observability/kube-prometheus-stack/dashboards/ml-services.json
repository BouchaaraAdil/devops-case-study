    },
    {
      "id": 4,
      "title": "ML API error rate",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(ml_api_requests_total{endpoint=\"/predict\",status=~\"5..\"}[5m])) / sum(rate(ml_api_requests_total{endpoint=\"/predict\"}[5m])) or vector(0)"
